# Copy to .env.local. Never commit the real thing.
# Ask your pod lead for values.

# ---- Supabase (safe in the browser: RLS protects the data) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS. Never prefix this NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenAI ----
# Server-side only. Anything prefixed NEXT_PUBLIC_ is visible in devtools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Observability ----
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
