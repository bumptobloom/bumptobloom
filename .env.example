# Copy to .env.local. Never commit the real thing.
# Ask your pod lead for values.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI service ----
# The browser never calls this directly; Next.js proxies.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=

# ---- OpenAI (apps/ai only — must NOT exist in the web app env) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Observability ----
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
