# Copy to .env.local. Never commit the real thing.
# Ask your pod lead for values.

# ---- Supabase (safe to ship in the app: RLS protects the data) ----
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Edge Function secrets ----
# These NEVER go in .env for the app. Set them with:
#   supabase secrets set OPENAI_API_KEY=sk-...
# Anything with EXPO_PUBLIC_ is readable by anyone who downloads the app.
# OPENAI_API_KEY
# SUPABASE_SERVICE_ROLE_KEY

# ---- Observability ----
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
