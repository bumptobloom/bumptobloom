# Copy to .env.local. Never commit the real thing.
# Ask your pod lead for values.

# ---- Supabase (safe in the browser: RLS protects the data) ----
# We use Supabase's new key system, not the legacy anon/service_role JWTs.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Starts sb_publishable_. Browser-safe by design; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Starts sb_secret_. Bypasses RLS entirely. Vercel env vars only, never a file,
# never a chat message, and never prefixed NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---- OpenAI ----
# Server-side only. Anything prefixed NEXT_PUBLIC_ is visible in devtools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Observability ----
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
