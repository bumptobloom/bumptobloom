{
  "name": "bumptobloom",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "bumptobloom",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@btb/fever-rules": {
      "resolved": "packages/fever-rules",
      "link": true
    },
    "node_modules/@btb/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/fever-rules": {
      "name": "@btb/fever-rules",
      "version": "0.1.0"
    },
    "packages/shared": {
      "name": "@btb/shared",
      "version": "0.1.0"
    }
  }
}
