{
  "name": "bumptobloom",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run start --workspace=apps/mobile",
    "build": "eas build --profile development",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:safety": "npm run test --workspace=packages/fever-rules && npm run test --workspace=packages/shared"
  }
}
